{
  "manifest_version": 3,
  "name": "Deadline Sentinel",
  "version": "1.0.0",
  "description": "Automatically detect assignment deadlines and send email reminders 24 hours before due dates",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://vtop.vit.ac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vtop.vit.ac.in/vtop/content*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deadline Sentinel"
  },
  "options_page": "options.html"
}
